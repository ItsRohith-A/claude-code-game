{
  "name": "toolstorm",
  "version": "0.2.2",
  "private": true,
  "description": "TOOLSTORM - a terminal arcade shooter fueled by Claude Code's tool calls",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.js",
    "play": "node dist/game/main.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
